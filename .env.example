# Copy this file to ".env" (or ".env.local") and fill in the values.
# Create React App only exposes variables prefixed with REACT_APP_.
# Restart `npm start` after changing these.

# --- Contact form (Web3Forms) ---
# 1. Go to https://web3forms.com
# 2. Enter luckybit0512@gmail.com as the destination inbox to get a free Access Key.
# 3. Paste the key below. Messages from the contact form are delivered to that inbox.
REACT_APP_WEB3FORMS_KEY=

# --- "Book a meeting" button (Google Calendar) ---
# Your Google Calendar appointment/booking page, e.g. https://calendar.app.google/xxxxxxxx
REACT_APP_CALENDAR_BOOKING_URL=

# --- Follow API (optional, already has a remote default) ---
# REACT_APP_FOLLOW_API_BASE_URL=
# REACT_APP_ENABLE_REMOTE_FOLLOWS=false
